---
const { entry, featured = false, importance = 0, size = 'm' } = Astro.props;
const { data, slug } = entry;
const tags = ['review', ...data.tags];
---
<a
  href={`/reviews/${slug}/`}
  class={`patch tight${featured ? ' on-dark night' : ''}`}
  data-box={slug}
  data-importance={importance}
  data-size={size}
>
  <div class="cover">
    {data.cover ? <img src={data.cover} alt={data.coverAlt ?? `${data.album} cover`} /> : 'Cover'}
  </div>
  <div class="tags">
    {tags.map((t) => <span class="tag">{t}</span>)}
  </div>
  <p class="rev-artist">{data.artist}</p>
  <h3 class="rev-title">{data.title}</h3>
  <div class="tldr">
    {data.tldr.map((t) => <span>{t}</span>)}
  </div>
</a>
